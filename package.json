{
  "name": "trello-portfolio",
  "private": true,
  "scripts": {
    "dev": "bun --cwd apps/frontend/my-app dev",
    "start": "bun --cwd apps/frontend/my-app start",
    "build": "bun --cwd apps/frontend/my-app build",
    "check-types": "bun --cwd apps/frontend/my-app check-types",
    "test": "bun test apps/frontend/my-app/src/server.test.ts",
    "format": "prettier --write \"apps/frontend/my-app/src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
